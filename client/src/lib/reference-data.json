      "image": "https://xiang1224.github.io/SnakeAcademy/images/rock/blue.webp"
    },
    {
      "id": 5,
      "name": "煙幕術",
      "kind": "輔助控制魔法",
      "tags": [
        "煙幕"
      ],
      "use": "召喚遮蔽視線與魔力感知的濃煙，適合用於干擾敵方判斷、偵查與潛行掩護，亦可與指定目標交換位置。",
      "image": "https://xiang1224.github.io/SnakeAcademy/images/rock/blue.webp"
    },
    {
      "id": 6,
      "name": "擊倒術",
      "kind": "輔助控制魔法",
      "tags": [
        "擊倒"
      ],
      "use": "利用瞬間爆發的魔力衝擊破壞目標重心，使其摔倒在地並製造控場空檔。",
      "image": "https://xiang1224.github.io/SnakeAcademy/images/rock/blue.webp"
    },
    {
      "id": 7,
      "name": "加速術",
      "kind": "咒術魔法",
      "tags": [
        "加速"
      ],
      "use": "大幅提升目標的移動速度與行動頻率，在戰鬥中獲得先手與閃避優勢。",
      "image": "https://xiang1224.github.io/SnakeAcademy/images/rock/purple.webp"
    },
    {
      "id": 8,
      "name": "開鎖術",
      "kind": "咒術魔法",
      "tags": [
        "開鎖"
      ],
      "use": "以精準的魔力震盪解開各類機械鎖頭、魔導鎖或基礎封印結構。",
      "image": "https://xiang1224.github.io/SnakeAcademy/images/rock/purple.webp"
    },
    {
      "id": 9,
      "name": "高躍術",
      "kind": "咒術魔法",
      "tags": [
        "高躍"
      ],
      "use": "增強腿部爆發力或施加輕量重力效果，使施法者能夠跳躍至高處或跨越障礙。",
      "image": "https://xiang1224.github.io/SnakeAcademy/images/rock/purple.webp"
    },
